<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EventPhotoBot\EventPhotoBot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      TestAssets/FixtureGenerator is its own throwaway console project (see its .csproj)
      used to regenerate the fixtures below; keep its source and build output out of this
      assembly's compilation.
    -->
    <Compile Remove="TestAssets\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="TestAssets\*.jpg" CopyToOutputDirectory="PreserveNewest" />
    <None Include="TestAssets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
